* text=auto

# Reproducible cross-platform scripts and workflow files.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf

# Binary assets and vendor-neutral workbook template.
*.png binary
*.ico binary
*.pdf binary
*.xlsx binary
*.zip binary
*.gz binary
*.dm7f binary
*.CLF binary
*.clf binary

# Immutable copies of the StageFlow suite guide manifest: preserve exact hashes.
docs/guides/GUIDE-SUITE-FR.md -text
docs/guides/SUITE-GUIDE-EN.md -text
docs/media/ecosystem/suite-*.svg -text
docs/SUITE_GUIDES_PROVENANCE.json -text
docs/suite-guides-manifest.json -text

# Native project templates must retain their exact vendor bytes on every OS.
assets/project-templates/** binary
assets/project-templates/README.md text eol=lf
assets/project-templates/ALLOWLIST.sha256 text eol=lf

# Preserve upstream notices verbatim, including their original trailing spaces.
third_party_licenses/** -whitespace
