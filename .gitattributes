* text=auto

# Reproducible cross-platform scripts and workflow files.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf

# Binary assets and vendor-neutral workbook template.
*.png binary
*.ico binary
*.pdf binary
*.xlsx binary
*.zip binary
*.gz binary
*.dm7f binary
*.CLF binary
*.clf binary

# Native project templates must retain their exact vendor bytes on every OS.
assets/project-templates/** binary
assets/project-templates/README.md text eol=lf
assets/project-templates/ALLOWLIST.sha256 text eol=lf

# Preserve upstream notices verbatim, including their original trailing spaces.
third_party_licenses/** -whitespace
